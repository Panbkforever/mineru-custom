# Python cache
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# AutoDL / local hidden files
.Trash-0/
.autodl/
.DS_Store

# nested git backup
MinerU/.git.backup_autodl/

# virtual environments
.venv/
venv/
env/
MinerU/.venv/

# data / runtime outputs
data/
dataset/
datasets/
checkpoints/
weights/
models/
runs/
outputs/
logs/
work_dirs/
mineru_output/
pdfs/

# large model / binary artifacts
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.engine
*.bin
*.so

# env files
.env

# 只跟踪项目根目录文件及指定源码目录。
/*/
!/post_table/
!/extract/
!/modify/
!/MinerU/
!/mineru_image_export/
/.env*

# 这些 data 目录是 MinerU 的 Python 源码，不是运行数据。
!/MinerU/mineru/data/
!/MinerU/mineru/data/**/
!/MinerU/mineru/data/**/*.py
!/MinerU/mineru/model/utils/pytorchocr/data/
!/MinerU/mineru/model/utils/pytorchocr/data/**/
!/MinerU/mineru/model/utils/pytorchocr/data/**/*.py

# 保留 MinerU 自带的演示和单元测试 PDF，不跟踪用户输入 PDF。
!/MinerU/demo/pdfs/
!/MinerU/demo/pdfs/*.pdf
!/MinerU/tests/unittest/pdfs/
!/MinerU/tests/unittest/pdfs/*.pdf
*.ckpt
*.safetensors
*.onnx
*.engine
*.bin
*.so

# env files
.env
